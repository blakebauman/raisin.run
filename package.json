{
  "name": "raisin",
  "version": "0.1.0",
  "private": true,
  "description": "Raisin — a technical SEO crawler as a multi-tenant SaaS, built entirely on Cloudflare. Turborepo + Biome.",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "biome format --write .",
    "check-types": "turbo run check-types",
    "web:dev": "pnpm --filter @raisin/web dev",
    "engine:dev": "pnpm --filter @raisin/engine dev",
    "fixture:dev": "pnpm --filter @raisin/fixture-site dev",
    "db:migrate:local": "pnpm --filter @raisin/web db:migrate:local",
    "deploy": "pnpm --filter @raisin/engine run deploy && pnpm --filter @raisin/web run deploy"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "^25.7.0",
    "turbo": "^2.5.8",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.5"
}
