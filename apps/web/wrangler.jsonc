{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "raisin-web",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "routes": [{ "pattern": "raisin.run", "custom_domain": true }],
  // Due schedules are checked every 15 minutes.
  "triggers": { "crons": ["*/15 * * * *"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "raisin", "migrations_dir": "../../packages/db/migrations" }
  ],
  "services": [{ "binding": "ENGINE", "service": "raisin-engine", "entrypoint": "EngineApi" }],
  // Transactional email (invitations). Simulated locally: messages are written to files.
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    "APP_URL": "https://raisin.run",
    // Public Turnstile site key; leave empty to disable the signup challenge.
    "TURNSTILE_SITE_KEY": "",
    // Sender for transactional email; must be on a domain onboarded to Email Sending.
    // Empty disables email.
    "EMAIL_FROM": "Raisin <notifications@raisin.run>"
  }
  // Secrets (wrangler secret put): BETTER_AUTH_SECRET, and optionally
  // GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, TURNSTILE_SECRET_KEY.
}
