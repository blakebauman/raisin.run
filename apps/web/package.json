{
  "name": "@raisin/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Dashboard, auth, REST API and schedule runner: React Router on Workers.",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "deploy": "pnpm build && wrangler deploy",
    "types": "wrangler types && react-router typegen",
    "db:migrate:local": "wrangler d1 migrations apply raisin --local",
    "db:migrate:remote": "wrangler d1 migrations apply raisin --remote",
    "test": "vitest run",
    "lint": "biome check .",
    "check-types": "react-router typegen && tsc --noEmit"
  },
  "dependencies": {
    "@raisin/core": "workspace:*",
    "@raisin/db": "workspace:*",
    "@raisin/ui": "workspace:*",
    "better-auth": "^1.7.7",
    "drizzle-orm": "catalog:",
    "isbot": "^5.1.36",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "^8.4.0",
    "stripe": "^23.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@raisin/typescript-config": "workspace:*",
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "^1.4.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
